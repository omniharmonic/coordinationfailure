{
  "name": "coordination-failure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server",
    "dev:web": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test --workspace=packages/engine",
    "test:classics": "npm run test --workspace=@coordination-failure/game-prisoners-dilemma --workspace=@coordination-failure/game-stag-hunt --workspace=@coordination-failure/game-tragedy-commons",
    "build:coordination-engine": "npm run build --workspace=@coordination-games/engine",
    "build:classics-plugins": "npm run build --workspace=@coordination-failure/game-prisoners-dilemma --workspace=@coordination-failure/game-stag-hunt --workspace=@coordination-failure/game-tragedy-commons",
    "classics:run": "node scripts/run-classics.mjs",
    "lint": "eslint packages/*/src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
